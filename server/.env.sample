# Copy to .env and edit. Never commit this file.

# Model: a Hugging Face repository id (downloaded on first start) or a local directory.
# CPU-only machines: Systran/faster-whisper-small or -medium are much faster.
WHISPER_MODEL=Systran/faster-whisper-large-v3

# auto = CUDA when a GPU can be used, otherwise CPU.
WHISPER_DEVICE=auto
# auto = float16 on CUDA, int8 on CPU. Other useful values: int8_float16, float32.
WHISPER_COMPUTE_TYPE=auto
# Number of CPU threads. 0 = let CTranslate2 choose.
WHISPER_CPU_THREADS=0

WHISPER_BEAM_SIZE=5
WHISPER_VAD=true
# Force one language, e.g. ru. Empty = use the client's ?languages= list.
WHISPER_LANGUAGE=
# Comma-separated words or names to bias recognition towards.
WHISPER_HOTWORDS=
# Overrides the built-in per-language dictation prompt. Quote values with spaces.
WHISPER_PROMPT=""
# Per-language prompts; WHISPER_PROMPT overrides both.
WHISPER_PROMPT_RU=""
WHISPER_PROMPT_EN=""
# Write the recognised text to the log. Off by default: dictation is private.
WHISPER_LOG_TEXT=false
WHISPER_MAX_UPLOAD_BYTES=67108864

# Shared secret. Empty = no authentication. Set it whenever the port is reachable
# from other machines.
WHISPER_TOKEN=

# 127.0.0.1 keeps the server local. Use 0.0.0.0 to serve other machines.
HOST=127.0.0.1
PORT=8766
LOG_LEVEL=info
